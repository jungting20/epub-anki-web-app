# Absolute path or path relative to the project
EPUB_DATA_DIR=./data

# Anki sync server: server-side only. Kubernetes supplies these using a Secret.
ANKI_SYNC_ENDPOINT=
ANKI_SYNC_USER=
ANKI_SYNC_PASSWORD=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4
# Docker uses /opt/anki/bin/python; on the OCI host, the existing venv can be used.
# ANKI_PYTHON=/home/hermes/anki-sync-server/venv/bin/python

# Hermes translation: fixed gpt-6-luna / medium, prompt passed via stdin.
HERMES_BIN=/home/hermes/.local/bin/hermes
# Container deployments can call the host's Hermes through SSH.
HERMES_SSH_TARGET=
HERMES_SSH_IDENTITY_FILE=
HERMES_SSH_KNOWN_HOSTS_FILE=
